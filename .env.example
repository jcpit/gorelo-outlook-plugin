# Local development: enter the key in the add-in on a trusted device only.
# Production: set keys privately in Railway runtime Variables, not in this file.
# Never commit, upload, or send a private .env file.
# Optional: OPENCODE_API_KEY=<your OpenCode Zen key> enables Jev ticket suggestions.
# Jev receives only the email subject and the first 2500 characters of plain text.
GORELO_BASE_URL=https://api.usw.gorelo.io
CORS_ORIGIN=https://localhost:5173
PORT=3001
# Production Outlook single sign-on. IDs are public registration metadata.
# REQUIRE_ENTRA_AUTH=true
# Replace these example UUIDs with your own app registration IDs.
# ENTRA_TENANT_ID=00000000-0000-4000-8000-000000000001
# ENTRA_CLIENT_ID=00000000-0000-4000-8000-000000000002
# ATTACHMENT_RETRY_DIR=/app/retry-data
# AUDIT_LOG_DIR=/app/retry-data/audit
